<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <RootNamespace>EndfieldChargePlus</RootNamespace><AssemblyName>EndfieldChargePlus</AssemblyName>
    <Product>Endfield Charge Plus For MacOS</Product><Title>Endfield Charge Plus For MacOS</Title>
    <Company>GlacierGlimmer_冰川雪貓</Company><Authors>GlacierGlimmer_冰川雪貓</Authors>
    <Copyright>© 2026 GlacierGlimmer_冰川雪貓</Copyright>
    <Description>Endfield-style menu bar and desktop HUD for macOS</Description>
    <Version>0.1.3</Version>
    <FileVersion>0.1.3.0</FileVersion>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <AvaloniaResource Include="Assets/tray_bolt.png" />
    <Compile Remove="Tests/**/*.cs;artifacts/**/*.cs" />
    <None Include="native/libecpmac.dylib" Condition="$([MSBuild]::IsOSPlatform('OSX'))" Link="libecpmac.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildMacNative" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/scripts/build-native.sh&quot; $(RuntimeIdentifier)" />
  </Target>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/china-holidays.json" LogicalName="EndfieldChargePlus.china-holidays.json" />
  </ItemGroup>
</Project>
